{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: read node and wallet state and ask for drafts. It can never approve one.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-node-status",
    "allow-restart-node",
    "allow-wallet-overview",
    "allow-wallet-activity",
    "allow-chain-overview",
    "allow-network-peers",
    "allow-dev-fund",
    "allow-draft-send",
    "allow-open-console",
    "allow-ui-theme",
    "allow-set-ui-theme",
    "allow-update-status",
    "allow-update-check",
    "allow-update-download",
    "allow-node-info",
    "allow-network-totals",
    "allow-wallets",
    "allow-wallet-manage",
    "allow-receive-new",
    "allow-receive-addresses",
    "allow-receive-show",
    "allow-wallet-backup",
    "allow-wallet-history",
    "allow-wallet-transaction",
    "allow-wallet-export-csv",
    "allow-node-settings",
    "allow-node-settings-apply",
    "allow-setup-info",
    "allow-setup-bootstrap",
    "allow-setup-cancel",
    "allow-setup-sync"
  ]
}
