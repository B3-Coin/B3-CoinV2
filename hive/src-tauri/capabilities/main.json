{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: read node and wallet state and ask for drafts. It can never approve one.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-node-status",
    "allow-restart-node",
    "allow-wallet-overview",
    "allow-dev-fund",
    "allow-draft-send",
    "allow-open-console",
    "allow-ui-theme",
    "allow-set-ui-theme"
  ]
}
