# Copy this file separately as .env.testnet and .env.mainnet. Never place a
# private key here; pass a Foundry hardware-wallet, keystore, or interactive
# signer when broadcasting.

# Deployment identity and target Ethereum network.
EXPECTED_DEPLOYER=0x0000000000000000000000000000000000000000
EXPECTED_CHAIN_ID=
ETH_RPC_URL=

# B3 chain identity. Copy the Ethereum/wire-order chain_domain from B3 RPC.
B3_CHAIN_DOMAIN=0x

# Six-decimal origin token. Mainnet must use canonical Ethereum USDT; testnet
# must use the reviewed six-decimal test token for that network.
ORIGIN_TOKEN=0x0000000000000000000000000000000000000000
EXPECTED_ORIGIN_TOKEN_CODE_HASH=0x

# Exact raw six-decimal caps. These are release decisions; do not guess them.
MAX_DEPOSIT_RAW=
B3_MAX_PER_BLOCK_RAW=

# Produced by b3-bridge-bootstrap-proof from four complete public identity
# exports. Do not paste any validator or BLS private key.
BOOTSTRAP_AGGREGATE_PUBKEY=0x
BOOTSTRAP_MEMBERS_ROOT=0x
EXPECTED_BOOTSTRAP_SET_HASH=0x
# SHA-256 of the exact reviewed public bootstrap-manifest.json bytes. The file
# contains public identities and proofs only; never include a private key.
BOOTSTRAP_MEMBERS_MANIFEST_SHA256=0x

# SHA-256 of the separately reviewed source/build provenance manifest. Preserve
# that manifest with the release evidence; a bare, undocumented hash is not
# sufficient review provenance.
SOURCE_BUILD_PROVENANCE_SHA256=0x

# Reviewed B3 schedule and Ethereum verifier limits.
MODERN_START_HEIGHT=811001
BRIDGE_ACTIVATION_HEIGHT=811001
MIN_BRIDGE_VALIDATORS=4
MAX_BRIDGE_VALIDATORS=64
MIN_BRIDGE_TOTAL_WEIGHT=
MIN_EPOCH_DURATION_SECONDS=86400
MAX_EPOCH_LAG_SECONDS=
MAX_CERTIFICATE_AGE_SECONDS=
MIN_DEPOSIT_EXIT_WINDOW_SECONDS=
BOOTSTRAP_DEADLINE_UNIX=

# Must stay inside contracts/deployments/.
CANDIDATE_MANIFEST_PATH=deployments/candidate.json

# Fill these only after all three deployment transactions are mined.
PROVER_ADDRESS=0x0000000000000000000000000000000000000000
EXPECTED_PROVER_RUNTIME_CODE_HASH=0x
VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000
EXPECTED_VERIFIER_RUNTIME_CODE_HASH=0x
VAULT_ADDRESS=0x0000000000000000000000000000000000000000
EXPECTED_VAULT_RUNTIME_CODE_HASH=0x
EXPECTED_B3_ASSET_ID=0x
# Copy deployment_config_hash from the independently reviewed candidate JSON.
# FinalizeDeployment recomputes it and refuses any different config/artifacts.
EXPECTED_DEPLOYMENT_CONFIG_HASH=0x
ORIGIN_DEPLOYMENT_BLOCK=
DEPLOYMENT_CONFIRMATIONS_REQUIRED=
FINAL_MANIFEST_PATH=deployments/final.json
