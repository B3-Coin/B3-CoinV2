pragma solidity ^0.8.24;

import {B3Types} from "../src/IB3FinalityProver.sol";
import {BlsCertificateProver} from "../src/BlsCertificateProver.sol";
import {B3FinalityVerifier} from "../src/B3FinalityVerifier.sol";

/// Full 3-of-4 cross-language bootstrap vector generated by
/// bridge::BuildBootstrapProof with B3's vendored blst. Unlike the single-key
/// primitive vector, this exercises canonical committee ordering, one absent
/// member and its depth-13 ordered path, signature aggregation, proof ABI, and
/// the complete initialize calldata.
contract BlsBootstrapVectorTest {
    bytes32 private constant CHAIN_DOMAIN = hex"d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0d0";
    bytes32 private constant BOOTSTRAP_SET_HASH = hex"5188225d2e128c1f51a61f4f6bad92dd8da6566549156bae3ebb81728158bf14";
    bytes32 private constant SET0_HASH = hex"747559ce1330e92e2153aac09cc71bb2f9ceb3c5a5d457c72b563136efd997ca";
    bytes private constant INITIALIZE_CALLDATA =
        hex"";

    function test_ThreeOfFourBootstrapCalldataVerifies() public {
        BlsCertificateProver prover = new BlsCertificateProver();
        B3Types.SetHeader memory bootstrap;
        bootstrap.epoch = 0;
        bootstrap.rulesetVersion = 1;
        bootstrap.validatorCount = 4;
        bootstrap.totalWeight = 4;
        bootstrap.quorumWeight = 3;
        bootstrap.aggregatePubkey =
        hex"afea1502f003a9ab0d8bf89c1826bc78d3e01413f9e78e836b0b99dba05c3ce5d9e81f1478697a4d776aeee83449ec54";
        bootstrap.membersRoot = hex"78621e43cecacca419e7d29cb7458f31262616dce6083cf3f32ddec1b67b5910";

        B3FinalityVerifier verifier = new B3FinalityVerifier(
            CHAIN_DOMAIN,
            bootstrap,
            BOOTSTRAP_SET_HASH,
            prover,
            address(prover).codehash,
            B3FinalityVerifier.DeploymentConfig({
                modernStartHeight: 811_001,
                bridgeActivationHeight: 811_001,
                minBridgeValidators: 4,
                maxBridgeValidators: 64,
                minBridgeTotalWeight: 1,
                minEpochDuration: 1 days,
                maxEpochLag: 30 days,
                maxCertificateAge: 1 days,
                minDepositExitWindow: 1 days,
                bootstrapDeadline: block.timestamp + 7 days
            })
        );

        (bool ok, bytes memory reason) = address(verifier).call(INITIALIZE_CALLDATA);
        if (!ok) {
            assembly ("memory-safe") {
                revert(add(reason, 32), mload(reason))
            }
        }
        require(verifier.initialized(), "not initialized");
        require(verifier.BOOTSTRAP_SET_HASH() == BOOTSTRAP_SET_HASH, "bootstrap hash");
        require(verifier.GENESIS_SET_HASH() == SET0_HASH, "Set_0 hash");
        require(verifier.currentSetHash() == SET0_HASH, "current Set_0");
    }
}
